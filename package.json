{
  "name": "trip-calc",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "cf build && pnpm db:migrate:remote && cf deploy --prebuilt",
    "plan": "cf deploy --dry-run",
    "build": "cf build",
    "preview": "cf build && vp preview",
    "dev": "cf dev",
    "db:migrate:local": "cf d1 migrations apply 7ba4c32c-3bac-4510-b1b7-5c6a567346f6 --dir src/migrations --local --persist-to .cloudflare/state",
    "db:generate": "drizzle-kit generate",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "test": "vp test",
    "typecheck": "tsgo --noEmit",
    "db:migrate:remote": "cf d1 migrations apply 7ba4c32c-3bac-4510-b1b7-5c6a567346f6 --dir src/migrations",
    "db:adopt:alchemy": "node scripts/adopt-alchemy-history.mjs"
  },
  "dependencies": {
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.23",
    "@solidjs/web": "2.0.0-rc.7",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-rc.117",
    "solid-js": "2.0.0-rc.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "@cloudflare/workers-types": "^5.20260910.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "cf": "1.0.0-beta.6",
    "drizzle-kit": "1.0.0-rc.4",
    "jsdom": "^30.0.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vite-plugin-solid": "3.0.0-next.27",
    "vite-plus": "^0.3.1"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "vite@*": "npm:@voidzero-dev/vite-plus-core@0.3.1",
      "vitest@*": "4.1.11"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
